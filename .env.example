# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
PUBLIC_APP_URL=
TRENDSFAST_SURFACE=public
PUBLIC_DEPLOYMENT_HOST=
PUBLIC_DEPLOYMENT_ID=
DATABASE_URL=postgresql://trendsfast:trendsfast_local@localhost:54329/trendsfast
MEMBER_DATABASE_URL=
# Hosted deployments use independently credentialed, transaction-pooled role URLs.
OPS_DATABASE_URL=
WORKER_DATABASE_URL=
BILLING_DATABASE_URL=
AUTH_DATABASE_URL=
RETENTION_DATABASE_URL=
# PEM CA for every hosted database role URL (literal newlines or escaped \\n).
DATABASE_SSL_CA=
# Use the direct connection for migrations and hosted schema verification.
DIRECT_DATABASE_URL=postgresql://trendsfast:trendsfast_local@localhost:54329/trendsfast
PROVIDER_CREDENTIAL_MODE=fixture
PROVIDER_CALLS_ENABLED=false
PUBLIC_SCANS_ENABLED=false
LIVE_API_CREATION_ENABLED=false
PUBLIC_SCAN_PROCESSING=inline
# Copy managed/BYOK operating limits from ignored .var/private/managed-policy.env.
# Self-hosters must supply and review their own assumptions; no managed values ship here.
MANAGED_POLICY_REVISION=
PUBLIC_SCAN_DAILY_LIMIT=
PUBLIC_SCAN_GLOBAL_DAILY_LIMIT=
PUBLIC_SCAN_GLOBAL_DAILY_BUDGET_USD=
API_CREATE_RATE_LIMIT_PER_HOUR=
API_STATUS_RATE_LIMIT_PER_HOUR=
API_AUTH_FAILURE_LIMIT_PER_HOUR=
API_PROVIDER_COST_LIMIT_USD_PER_HOUR=
SCAN_RETENTION_DAYS=
# Ops surface only. Leave absent on the public deployment.
OPS_TOKEN=
SESSION_SECRET=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-at-least-32-random-characters

# Provider accounts (server-side only)
XAI_API_KEY=
XAI_MODEL=
XAI_ESTIMATED_COST_USD_PER_SEARCH=
XAI_MAX_TOOL_CALLS_PER_SCAN=2
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_GOOGLE_TRENDS_MODE=live
DATAFORSEO_ESTIMATED_COST_USD_PER_TASK=
TAVILY_API_KEY=
TAVILY_ESTIMATED_COST_USD_PER_CREDIT=
TAVILY_MAX_CREDITS_PER_SCAN=2
YOUTUBE_API_KEY=
YOUTUBE_INTERNAL_QUOTA_VALUE_USD=
YOUTUBE_MAX_SEARCHES_PER_SCAN=2
GITHUB_TOKEN=
LLM_PROVIDER=xai
LLM_MODEL=
OPENAI_API_KEY=
# Required outside fixture mode; copy the operator's dated model price schedule.
LLM_INPUT_PRICE_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_PRICE_USD_PER_MILLION_TOKENS=
MAX_PROVIDER_COST_USD_PER_SCAN=
MAX_SCAN_DURATION_SECONDS=240
PROVIDER_TIMEOUT_MS=15000

# Public launch surface (all optional)
NEXT_PUBLIC_ANNOUNCEMENT_ENABLED=true
NEXT_PUBLIC_ANNOUNCEMENT_TEXT=I’m running free trend and distribution scans for technical founders.
NEXT_PUBLIC_DEMO_VIDEO_URL=
NEXT_PUBLIC_DEMO_CAPTIONS_URL=

# Supabase Auth identity only. These publishable browser values do not grant
# direct access to TrendsFast business tables; application repositories remain
# the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Abuse protection
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Billing and monitoring stay off until every live enablement gate passes.
BILLING_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
PAID_MONITORING_ENABLED=false
MONITORING_ENABLED=false
# Exact YES is required only after a paid host with the committed cron cadence is approved.
PAID_HOSTING_APPROVED=
FOUNDING_100_ENABLED=false
CLOUD_TRIAL_ENABLED=false
STRIPE_MODE=test
# Keep every sandbox CLI helper blocked until the previously exposed key is revoked.
STRIPE_SANDBOX_KEY_ROTATED=
I_UNDERSTAND_LIVE_STRIPE=
STRIPE_LIVE_CATALOG_APPROVED=
STRIPE_LIVE_ENABLEMENT_APPROVED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDER_CLOUD_PRICE_ID=
# Stripe Dashboard > Customer Portal > activate no-code login, then paste only its /p/login URL.
STRIPE_PORTAL_LOGIN_URL=
CRON_SECRET=replace-with-at-least-32-random-characters
# Optional outside production; production monitoring requires this runtime-only signed pair.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=
MONITORING_CRON_BATCH_SIZE=1
MONITORING_LEASE_SECONDS=300
MONITORING_MAX_ATTEMPTS=3
MONITORING_RETRY_BASE_SECONDS=300
MONITORING_REVIEW_ALERT_AGE_SECONDS=86400
OPS_HEALTH_MAX_AGE_SECONDS=129600

# Optional external analytics
DATAFAST_ENABLED=false
DATAFAST_WEBSITE_ID=
