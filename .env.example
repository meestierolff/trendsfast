# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://trendsfast:trendsfast_local@localhost:54329/trendsfast
# Use the direct connection for migrations and hosted schema verification.
DIRECT_DATABASE_URL=postgresql://trendsfast:trendsfast_local@localhost:54329/trendsfast
PROVIDER_CREDENTIAL_MODE=fixture
BYOK_ACCEPT_CONSERVATIVE_COST_ESTIMATES=
PUBLIC_SCAN_PROCESSING=inline
PUBLIC_SCAN_DAILY_LIMIT=1
PUBLIC_SCAN_GLOBAL_DAILY_LIMIT=20
PUBLIC_SCAN_GLOBAL_DAILY_BUDGET_USD=5
API_CREATE_RATE_LIMIT_PER_HOUR=20
API_STATUS_RATE_LIMIT_PER_HOUR=300
API_AUTH_FAILURE_LIMIT_PER_HOUR=20
API_PROVIDER_COST_LIMIT_USD_PER_HOUR=
SCAN_RETENTION_DAYS=90
OPS_TOKEN=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-at-least-32-random-characters

# Provider accounts (server-side only)
XAI_API_KEY=
XAI_MODEL=
XAI_ESTIMATED_COST_USD_PER_SEARCH=
XAI_MAX_TOOL_CALLS_PER_SCAN=2
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_GOOGLE_TRENDS_MODE=live
DATAFORSEO_ESTIMATED_COST_USD_PER_TASK=
TAVILY_API_KEY=
TAVILY_ESTIMATED_COST_USD_PER_CREDIT=
TAVILY_MAX_CREDITS_PER_SCAN=2
YOUTUBE_API_KEY=
YOUTUBE_INTERNAL_QUOTA_VALUE_USD=
YOUTUBE_MAX_SEARCHES_PER_SCAN=2
GITHUB_TOKEN=
LLM_PROVIDER=xai
LLM_MODEL=
OPENAI_API_KEY=
# Required outside fixture mode; copy the operator's dated model price schedule.
LLM_INPUT_PRICE_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_PRICE_USD_PER_MILLION_TOKENS=
MAX_PROVIDER_COST_USD_PER_SCAN=
MAX_SCAN_DURATION_SECONDS=240
PROVIDER_TIMEOUT_MS=15000

# Public launch surface (all optional)
NEXT_PUBLIC_ANNOUNCEMENT_ENABLED=true
NEXT_PUBLIC_ANNOUNCEMENT_TEXT=I’m running free trend and distribution scans for technical founders.
NEXT_PUBLIC_DEMO_VIDEO_URL=
NEXT_PUBLIC_DEMO_CAPTIONS_URL=

# Abuse protection
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Billing and monitoring stay off until every live enablement gate passes.
BILLING_ENABLED=false
PAID_MONITORING_ENABLED=false
FOUNDING_100_ENABLED=false
CLOUD_TRIAL_ENABLED=false
STRIPE_MODE=test
# Keep every sandbox CLI helper blocked until the previously exposed key is revoked.
STRIPE_SANDBOX_KEY_ROTATED=NO
I_UNDERSTAND_LIVE_STRIPE=
STRIPE_LIVE_ENABLEMENT_APPROVED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDER_CLOUD_PRICE_ID=
# Stripe Dashboard > Customer Portal > activate no-code login, then paste only its /p/login URL.
STRIPE_PORTAL_LOGIN_URL=
CRON_SECRET=replace-with-at-least-32-random-characters
MONITORING_CRON_BATCH_SIZE=1
MONITORING_LEASE_SECONDS=300

# Optional external analytics
DATAFAST_ENABLED=false
DATAFAST_WEBSITE_ID=
