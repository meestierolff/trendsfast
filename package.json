{
  "name": "trendsfast",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Open-source social and search trend intelligence for founders and their AI agents.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @trendsfast/web dev",
    "build": "pnpm --filter @trendsfast/web build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @trendsfast/web test:e2e",
    "db:generate": "drizzle-kit generate --config packages/database/drizzle.config.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:purge": "tsx packages/database/src/purge.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "db:studio": "drizzle-kit studio --config packages/database/drizzle.config.ts",
    "db:verify-hosted": "tsx scripts/db/verify-hosted-schema.ts",
    "db:sync-policy": "tsx scripts/db/sync-managed-runtime-policy.ts",
    "db:provision-roles": "tsx scripts/db/provision-runtime-roles.ts",
    "db:verify-roles": "tsx scripts/db/verify-runtime-roles.ts",
    "ops:record-health": "tsx scripts/db/record-operations-health.ts",
    "dogfood:export": "NODE_OPTIONS=--conditions=react-server tsx scripts/export-dogfood-bundle.ts",
    "private:bootstrap": "./scripts/bootstrap-private-state.sh",
    "env:import-production": "tsx scripts/import-production-env.ts",
    "openapi:generate": "node --import tsx scripts/generate-openapi.ts",
    "stripe:bootstrap-sandbox": "./scripts/stripe/bootstrap-sandbox.sh",
    "stripe:verify-sandbox": "./scripts/stripe/verify-sandbox.sh",
    "stripe:test-webhook": "./scripts/stripe/test-webhook.sh",
    "stripe:bootstrap-live": "./scripts/stripe/bootstrap-live.sh",
    "stripe:verify-live": "./scripts/stripe/verify-live.sh",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-import": "^2.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
